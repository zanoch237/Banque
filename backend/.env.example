# Variables d'environnement - Banque d'Épreuves Backend
# Copiez ce fichier en .env et remplissez les valeurs

# Port d'écoute du serveur Express
PORT=5000

# URI de connexion à MongoDB
MONGODB_URI=mongodb://localhost:27017/banque_epreuves

# Clé secrète pour signer les tokens JWT (changez impérativement en production !)
JWT_SECRET=change_this_secret_in_production

# Durée de validité du token JWT
JWT_EXPIRES_IN=7d

# Environnement d'exécution : development | production | test
NODE_ENV=development

# URL du frontend (utilisé en production pour CORS)
# FRONTEND_URL=https://votre-domaine.com
